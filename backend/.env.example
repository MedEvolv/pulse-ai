# Pulse AI backend — non-secret template. Copy to .env and fill values.
# Leave MONGO_URL empty to use the in-memory fallback (synthetic demo, non-durable).
MONGO_URL=
DB_NAME=pulse_ai
CORS_ORIGINS=http://localhost:3000
# Model is OFF by default; deterministic briefing always works without a key.
EMERGENT_LLM_KEY=
MODEL_ENABLED=false
MODEL_DAILY_RUN_LIMIT=25
MODEL_MIN_SECONDS_BETWEEN_RUNS=20
MODEL_TIMEOUT_SECONDS=12
MODEL_CACHE_TTL_SECONDS=86400
MODEL_MAX_OUTPUT_TOKENS=700
